<html>
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    .container {
      padding: 0 10px;
    }
    .header {
      padding: 24px 0 36px;
      width: 100%;
    }
    .header .logo {
      text-align: right;
    }
    .header .title {
      font-size: 24px;
      color: rgba(33, 40, 60, 0.69);
      text-align: center;
    }
    .content {
      padding: 36px 0;
      text-align: center;
    }
    .footer {
      font-size: 12px;
      color: rgba(33, 40, 60, 0.50);
      padding-top: 22px;
      text-align: center;
    }
    .footer a {
      font-size: 16px;
      color: rgba(33, 40, 60, 0.50);
    }
    .line {
      border-top: 1px dashed #9ACEDD;
      max-width: 520px;
      width: 100%;
      margin: 0 auto;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <div class="logo">
        <img style="width: 138px;" src="<%= logo_base64 %>" alt="">
      </div>
      <div class="title" style="margin-top: 36px;">
        <%= content_for(:title) if content_for?(:title) %>
      </div>
    </div>
    <%= call_hook(:view_layouts_mailer_html_before_content, assigns) %>
    <div class="line"></div>
    <div class="content">
      <%= yield %>
    </div>
    <div class="line"></div>
    <%= call_hook(:view_layouts_mailer_html_after_content, assigns) %>
    <div class="footer">
      <div><%= Setting.app_title %> 网址：</div>
      <div style="margin-top: 12px;">
        <a href="<%= root_url %>"><%= root_url %></a>
      </div>
      <div style="margin-top: 15px;">
        <div style="text-align: center;"><%= Setting.app_title %> 公众号：</div>
        <div class="qrcode">
          <img style="width: 129px;" src="<%= mp_qrcode_base64 %>" alt="天华<%= Setting.app_title %>" >
        </div>
      </div>
    </div>
  </div>
</body>
</html>
