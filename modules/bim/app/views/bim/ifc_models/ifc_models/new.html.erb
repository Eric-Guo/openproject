<%=
  render Primer::OpenProject::PageHeader.new do |header|
    header.with_title { t("ifc_models.label_new_ifc_model") }
    header.with_breadcrumbs(
      [{ href: project_overview_path(@project.id), text: @project.name },
       { href: defaults_bcf_project_ifc_models_path(@project.identifier), text: I18n.t(:"bcf.label_bcf") },
       { href: bcf_project_ifc_models_path(@project.identifier), text: I18n.t(:"ifc_models.label_ifc_models") },
       t("ifc_models.label_new_ifc_model")]
    )
  end
%>

<% if OpenProject::Configuration.direct_uploads? %>
  <% max_size = Setting.attachment_max_size.to_i.kilobytes %>
  <%=
    primer_form_with(
      model: @ifc_model,
      url: @form[:uri],
      multipart: true,
      authenticity_token: false,
      data: {
        controller: "bim--ifc-model-direct-upload",
        action: "submit->bim--ifc-model-direct-upload#upload",
        "bim--ifc-model-direct-upload-max-size-value": max_size,
        "bim--ifc-model-direct-upload-too-large-message-value": t("bim.error_direct_upload_file_too_large", size: max_size),
        "bim--ifc-model-direct-upload-set-model-title-url-value": set_direct_upload_file_name_bcf_project_ifc_models_path
      }
    ) do |f|
  %>
    <% @form.except(:uri).each do |key, value| %>
      <input type="hidden" name="<%= key %>" value="<%= value %>">
    <% end %>

    <%=
      render_inline_form(f) do |form|
        form.file_field(
          name: :file,
          scope_name_to_model: false,
          id: "ifc-direct-upload-file-input",
          label: Bim::IfcModels::IfcModel.human_attribute_name(:ifc_attachment),
          accept: ".ifc",
          required: true,
          data: {
            action: "change->bim--ifc-model-direct-upload#validateFile",
            "bim--ifc-model-direct-upload-target": "fileInput"
          }
        )
        form.check_box(
          name: :is_default,
          label: Bim::IfcModels::IfcModel.human_attribute_name(:is_default),
          data: { "bim--ifc-model-direct-upload-target": "defaultModel" }
        )
        form.submit(
          name: :save,
          label: I18n.t(:button_create),
          scheme: :primary,
          disabled: true,
          data: { "bim--ifc-model-direct-upload-target": "submitButton" }
        )
      end
    %>
  <% end %>
<% else %>
  <%=
    primer_form_with(
      model: @ifc_model,
      url: bcf_project_ifc_models_path(@project),
      method: :post,
      multipart: true
    ) do |f|
      render_inline_form(f) do |form|
        form.file_field(
          name: :ifc_attachment,
          label: Bim::IfcModels::IfcModel.human_attribute_name(:ifc_attachment),
          accept: ".ifc",
          required: true
        )
        form.check_box(name: :is_default, label: Bim::IfcModels::IfcModel.human_attribute_name(:is_default))
        form.submit(name: :save, label: I18n.t(:button_create), scheme: :primary)
      end
    end
  %>
<% end %>
