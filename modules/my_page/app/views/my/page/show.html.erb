<% html_title(t("my_page.label")) -%>

<%=
  render(Primer::OpenProject::SubHeader.new) do |component|
  
    component.with_action_button(tag: :a,
                                 href: 'https://ith-workspace.thape.com.cn/projects',
                                 leading_icon: :'search',
                                 scheme: :primary,
                                 location: :left,
                                 target: "_blank", rel: "noopener",
                                 label: t(:label_th_project_filter)) do
      t(:label_th_project_filter)
    end

    toggle_initial_href = @auto_load_welcome ? my_page_hide_welcome_path : my_page_welcome_path
    component.with_action_button(icon_only: true,
      tag: :a,
      id: "th-welcome-toggle",
      leading_icon: :info,
      href: toggle_initial_href,
      data: { turbo: true, turbo_stream: true, welcome_href: my_page_welcome_path, hide_href: my_page_hide_welcome_path },
      label: "小贴士",
      location: :left)
    component.with_text(location: :left) { link_to @one_news.title, news_path(@one_news), target: "_news" }

    component.with_action_button(tag: :a,
                                 href: '/th_keyin',
                                 leading_icon: :'id-badge',
                                 scheme: :primary,
                                 target: "_blank", rel: "noopener",
                                 label: t(:label_th_keyin)) do
      t(:label_th_keyin)
    end

    component.with_action_button(tag: :a,
                                 href: 'https://ith-workspace.thape.com.cn/worktime/',
                                 leading_icon: :'op-gitlab-issue-closed',
                                 scheme: :primary,
                                 target: "_blank", rel: "noopener",
                                 label: t(:label_th_keyin_check)) do
      t(:label_th_keyin_check)
    end

    component.with_action_button(tag: :a,
                                 href: 'https://cybros.thape.com.cn/report/subsidiary_working_hours',
                                 leading_icon: :'op-cost-reports',
                                 scheme: :primary,
                                 target: "_blank", rel: "noopener",
                                 label: t(:label_th_keyin_report)) do
      t(:label_th_keyin_report)
    end

    component.with_action_button(tag: :a,
                                 href: 'https://ith-workspace.thape.com.cn/projects/milestones',
                                 leading_icon: :'git-commit',
                                 scheme: :primary,
                                 target: "_blank", rel: "noopener",
                                 label: t(:label_th_milestones)) do
      t(:label_th_milestones)
    end
  end 
%>

<%= turbo_frame_tag "th-my-page-welcome", src: (@auto_load_welcome ? my_page_welcome_path : nil) do %>
<% end %>

<%= nonced_javascript_tag do %>
  (function() {
    if (window.__thWelcomeToggleInitialized__) { return; }
    window.__thWelcomeToggleInitialized__ = true;

    document.addEventListener('turbo:before-stream-render', function(event) {
      var stream = event.target;
      if (!stream || stream.tagName !== 'TURBO-STREAM') { return; }
      var target = stream.getAttribute('target');
      if (target !== 'th-my-page-welcome') { return; }

      var btn = document.getElementById('th-welcome-toggle');
      if (!btn) { return; }

      var welcomeHref = btn.getAttribute('data-welcome-href');
      var hideHref = btn.getAttribute('data-hide-href');
      if (!welcomeHref || !hideHref) { return; }

      var current = btn.getAttribute('href');
      var next = (current === welcomeHref) ? hideHref : welcomeHref;
      btn.setAttribute('href', next);
    });
  })();
<% end %>

<%= render(Primer::Alpha::Stack.new(direction: browser.mobile? ? :vertical : :horizontal, justify: :space_evenly)) do %>
  <% if @show_budget_overrun_projects %>
    <%= render(Primer::BaseComponent.new(tag: :div, p: 3, m: (browser.mobile? ? 0 : 2), bg: :attention, border_radius: 2, style: 'min-width: 200px; max-width: 350px')) do %>
      <%=
        render(Primer::Alpha::ActionList.new(
                 role: Primer::Alpha::ActionList::DEFAULT_ROLE,
                 scheme: :inset,
                 show_dividers: false
               )) do |component|
          component.with_heading(title: t(:label_th_budget_overrun_projects))
          budget_overrun_projects = @budget_overrun_projects&.limit(5) || []
          if budget_overrun_projects.any?
            budget_overrun_projects.each do |project|
              component.with_item(label: project.name, href: "https://ith-workspace.thape.com.cn/projects/#{project.id}/costs", target: "_blank", rel: "noopener") do |item|
                item.with_leading_visual_icon(icon: :alert)
              end
            end
          else
            component.with_item(label: t(:label_th_no_budget_overrun_projects))
          end
        end
       %>
    <% end %>
  <% end %>
  <%= render(Primer::BaseComponent.new(tag: :div, p: 3, m: (browser.mobile? ? 0 : 2), bg: :attention, border_radius: 2, style: 'min-width: 200px; max-width: 350px')) do %>
