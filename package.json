{
  "name": "openproject",
  "version": "0.1.0",
  "scripts": {
    "postinstall": "cd frontend && pnpm install",
    "test": "cd frontend && pnpm test && cd ..",
    "tslint_typechecks": "cd frontend && pnpm run tslint_typechecks && cd ..",
    "serve": "cd frontend && pnpm run serve",
    "serve:public": "cd frontend && ./node_modules/.bin/ng serve --host 0.0.0.0"
  },
  "private": true,
  "engines": {
    "node": "^22.15.0",
    "npm": "^10.1.0"
  },
  "devDependencies": {
    "@redocly/openapi-cli": "^1.0.0-beta.80"
  },
  "dependencies": {
    "@xeokit/xeokit-gltf-to-xkt": "^1.3.1"
  },
  "resolutions": {
    "mime-db": "~1.54.0"
  },
  "packageManager": "pnpm@10.20.0"
}
